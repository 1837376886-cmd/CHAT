<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lytboot.auction.mapper.AuctionSurveyMapper">

    <resultMap id="BaseResultMap" type="com.lytboot.auction.domain.entity.AuctionSurvey">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="activity_id" property="activityId" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="real_name" property="realName" jdbcType="VARCHAR"/>
        <result column="survey_user_phone" property="surveyUserPhone" jdbcType="VARCHAR"/>
        <result column="survey_user_name" property="surveyUserName" jdbcType="VARCHAR"/>
        <result column="survey_status" property="surveyStatus" jdbcType="VARCHAR"/>
        <result column="survey_type" property="surveyType" jdbcType="VARCHAR"/>
        <result column="survey_file" property="surveyFile" jdbcType="VARCHAR"/>
        <result column="create_by" property="createBy" jdbcType="BIGINT"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_by" property="updateBy" jdbcType="BIGINT"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="remark" property="remark" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="selectByActivityAndUser" resultMap="BaseResultMap">
        SELECT * FROM auction_survey WHERE activity_id = #{activityId} AND user_id = #{userId} LIMIT 1
    </select>

</mapper>
