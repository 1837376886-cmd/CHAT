<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lytboot.auction.mapper.AuctionStateScheduleMapper">

    <resultMap id="BaseResultMap" type="com.lytboot.auction.domain.entity.StateScheduleTask">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="activity_id" property="activityId" jdbcType="BIGINT"/>
        <result column="transition_type" property="transitionType" jdbcType="VARCHAR"/>
        <result column="scheduled_time" property="scheduledTime" jdbcType="TIMESTAMP"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT * FROM auction_state_schedule WHERE status = #{status}
    </select>

    <select id="selectPending" resultMap="BaseResultMap">
        SELECT * FROM auction_state_schedule WHERE activity_id = #{activityId} AND transition_type = #{type} AND status = '0' LIMIT 1
    </select>

    <update id="updateStatus">
        UPDATE auction_state_schedule SET status = #{status} WHERE id = #{id}
    </update>

    <update id="updateStatusByActivityAndType">
        UPDATE auction_state_schedule SET status = #{status} WHERE activity_id = #{activityId} AND transition_type = #{type}
    </update>

</mapper>
